# Copy to .env, chmod 600 .env, and replace placeholders before normal startup.
ANTHROPIC_API_KEY=replace-with-your-own-provider-key
# Use two independent high-entropy values, e.g. openssl rand -hex 32 (twice).
WEBHOOK_SECRET=replace-with-independent-random-gateway-secret
WEBHOOK_SHARED_SECRET=replace-with-independent-random-router-secret
# Optional Telegram: also enable its adapter in an ignored local config copy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# HERMES_CONFIG=./local/config.yaml
